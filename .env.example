# Lumé — environment variables
# Copy to .env.local and fill in. The store runs fully WITHOUT any of these:
# products come from the seed catalog (src/lib/products.ts) and checkout falls
# back to "saved to bag" until Stripe is connected. Add these to go live.

# --- Site ---
# Your production URL. Used for canonical links, sitemap, OG, and Stripe
# redirects.
NEXT_PUBLIC_SITE_URL=https://lume-store.vercel.app

# --- Stripe (payments) ---
# Add STRIPE_SECRET_KEY to turn on real checkout. Prices are built server-side
# from the catalog, so there is NOTHING to configure in the Stripe dashboard.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks. Endpoint: /api/stripe/webhook
# (event: checkout.session.completed). Enables order recording + sale alerts.
STRIPE_WEBHOOK_SECRET=

# --- Supabase (optional — live catalog + order history) ---
# Without these, the store serves the seed catalog and adding a product returns
# a paste-ready snippet. With them, /admin writes products live (no redeploy)
# and the webhook records orders. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — never commit. Enables product writes (admin) and order inserts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin protection (optional but recommended) ---
# When set, POST /api/products requires this token (entered on the /admin page).
ADMIN_TOKEN=

# --- Sale alerts (optional) ---
# Incoming webhook URL — every completed order pings this Slack channel.
SLACK_ORDERS_WEBHOOK_URL=

# --- Rate limiting (optional, recommended before real traffic) ---
# Upstash Redis (https://upstash.com — free tier is plenty) protects
# /api/checkout and /api/products from abuse. Unset = routes work, unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
