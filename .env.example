# Vertex AI — environment variables
# Copy to .env.local and fill in to override defaults.
# The app runs fully without these — the public Vertex Supabase URL + anon key
# are baked into src/lib/supabase.ts (anon keys are public by design; RLS does
# the protecting).
#
# NOTE: we use VERTEX_-prefixed names on purpose. The generic
# NEXT_PUBLIC_SUPABASE_* names are intentionally NOT read, to avoid colliding
# with stale values left on the Vercel project by a previous app.

# --- Supabase overrides (optional) ---
VERTEX_SUPABASE_URL=
VERTEX_SUPABASE_ANON_KEY=
# Secret — never commit. Unlocks privileged server reads if added later.
VERTEX_SUPABASE_SERVICE_ROLE_KEY=

# --- Lead notifications (optional) ---
SLACK_LEADS_WEBHOOK_URL=

# --- Stripe (self-serve subscriptions) ---
# Add these to turn on paid plans. With STRIPE_SECRET_KEY set, the app
# auto-creates the Products + Prices in Stripe on first checkout — no manual
# price setup needed. The webhook also writes to the customers/subscriptions
# tables using VERTEX_SUPABASE_SERVICE_ROLE_KEY, so set that too.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks (endpoint: /api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Optional: pin to existing Stripe price IDs instead of auto-created ones.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# --- Automated onboarding email (optional, via Resend) ---
RESEND_API_KEY=
# Verified sender on your domain, e.g. "Vertex AI <hello@yourdomain.com>"
EMAIL_FROM=

# --- HubSpot CRM sync (optional) ---
# Private App token with the crm.objects.contacts.write scope. When set, every
# /contact and /audit lead is upserted as a HubSpot contact.
HUBSPOT_TOKEN=

# --- Live AI chat demo (optional) ---
# Backend chain: NVIDIA DeepSeek (primary) → Claude (backup) → scripted replies.
# NVIDIA NIM API key (https://build.nvidia.com) powers DeepSeek v4 Pro.
NVIDIA_API_KEY=
# Optional model override (defaults to deepseek-ai/deepseek-v4-pro).
NVIDIA_MODEL=
# Anthropic key — used as the backup if NVIDIA is unset or errors.
ANTHROPIC_API_KEY=

# --- Headroom token compression (optional) ---
# Route the chat's LLM calls through a `headroom proxy` to cut token cost
# 60-95%. Point HEADROOM_PROXY_URL at the proxy's OpenAI-compatible base
# (e.g. https://your-proxy.example.com/v1). Falls back to NVIDIA direct.
HEADROOM_PROXY_URL=
# Optional: separate override if you don't use Headroom but want another
# OpenAI-compatible base for the DeepSeek call.
NVIDIA_BASE_URL=
# Optional: also route the Claude backup through Headroom (Anthropic base URL).
ANTHROPIC_BASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://getvertex.vercel.app
