# Vertex AI — environment variables
# Copy to .env.local and fill in when wiring up a backend.
# The app runs fully without these (lead capture and auth fall back to demo mode).

# --- Supabase (optional, for real dashboard/portal data + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead notifications (optional) ---
# Incoming /api/contact leads can be posted to a Slack incoming webhook.
SLACK_LEADS_WEBHOOK_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://vertex-ai.vercel.app
