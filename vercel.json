{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/weekly-matches",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/ghost-check",
      "schedule": "0 9 * * *"
    }
  ]
}
